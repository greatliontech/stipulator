# proto-file: proto/stipulator/v1/policy.proto
# proto-message: stipulator.v1.TestPolicy

invocations {
  name: "race"
  # Budgets cover a cold FULL re-execution of the whole witness set
  # under the gofresh v0.105.1 engine. Measured 2026-09-21 from an
  # empty store, on a check one red pin (since fixed) failed, so the
  # wall alone stands: 46m51s whole-check wall (execution 44m53s) for
  # 770 executed, 464 uncacheable, 0 served; the race binary of
  # internal/backends/golang, 2685s, the long pole (1805s+ on
  # 2026-08-26, when it aborted the previous 30m binary budget twice).
  # 100m per test binary is ~2.2x that long pole; 7200s per invocation
  # is ~2.7x the race invocation's own wall (~2.6x the whole check's).
  timeout {
    seconds: 7200
  }
  go {
    packages: "./..."
    race: true
    args: "-test.timeout=100m"
    bracket_paths: "/bin/sh"
    bracket_paths: "/usr/bin/sh"
    bracket_paths: "/usr/bin/git"
    bracket_paths: "go.work"
    bracket_paths: "internal"
    bracket_paths: "go.mod"
    bracket_paths: "go.sum"
    bracket_paths: ".stipulator/policy.textproto"
    assume_pure: true
  }
}
invocations {
  name: "race:stipulate"
  timeout {
    seconds: 2700
  }
  go {
    module_root: "stipulate"
    packages: "./..."
    race: true
    bracket_paths: "/bin/sh"
    bracket_paths: "/usr/bin/sh"
    bracket_paths: "/usr/bin/git"
    bracket_paths: "go.work"
    bracket_paths: "internal"
    bracket_paths: "go.mod"
    bracket_paths: "go.sum"
    bracket_paths: ".stipulator/policy.textproto"
    assume_pure: true
    args: "-test.timeout=30m"
  }
}
invocations {
  name: "race:stipulate/structural"
  timeout {
    seconds: 2700
  }
  go {
    module_root: "stipulate/structural"
    packages: "./..."
    race: true
    bracket_paths: "/bin/sh"
    bracket_paths: "/usr/bin/sh"
    bracket_paths: "/usr/bin/git"
    bracket_paths: "go.work"
    bracket_paths: "internal"
    bracket_paths: "go.mod"
    bracket_paths: "go.sum"
    bracket_paths: ".stipulator/policy.textproto"
    assume_pure: true
    args: "-test.timeout=30m"
  }
}
